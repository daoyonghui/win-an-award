# PrintMind 环境变量示例
# 复制为 .env 后填入自己的配置；不要提交真实密钥到版本库。
# 未配置 API Key 时，系统会自动回退到规则诊断，不影响运行。

# ===== DeepSeek 视觉模型（V4 Flash Vision Exp）=====
# API Key（留空表示未配置，切勿写死在代码中）
DEEPSEEK_API_KEY=your_key_here
# 接口地址（默认 https://api.deepseek.com，一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 视觉模型名称（默认 deepseek-flash）
# 兼容说明：旧名称 deepseek-v4-flash-vision-exp 仍可手动填写，但不再作为默认值。
DEEPSEEK_VISION_MODEL=deepseek-flash
# 请求超时（秒）
VISION_TIMEOUT=60

# ===== 兼容旧变量（可选，作为回退）=====
# 若未设置 DEEPSEEK_API_KEY，会尝试使用 VISION_API_KEY / VISION_MODEL
VISION_API_KEY=
VISION_MODEL=
